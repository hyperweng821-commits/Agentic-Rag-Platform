# Application
APP_NAME=agentic-rag-backend
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false
DOCS_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
# Leave empty to use human-readable logs locally and JSON logs in production.
LOG_JSON=

# PostgreSQL
POSTGRES_DB=agentic_rag
POSTGRES_USER=agentic_rag
POSTGRES_PASSWORD=agentic_rag_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agentic_rag:agentic_rag_dev_only@localhost:5432/agentic_rag
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_HEALTHCHECK_TIMEOUT_SECONDS=2

# ChromaDB (future infrastructure; enabled only with the rag profile)
CHROMA_HOST=chroma
CHROMA_HTTP_PORT=8000
CHROMA_EXPOSED_PORT=8001

# Ollama (future infrastructure; enabled only with the rag profile)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
